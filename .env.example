# Plantilla de variables de entorno (SPEC-007). Copia a .env y rellena los valores.
# Nunca pongas valores reales en este archivo.

# --- Frontend (expuestas al navegador) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SOLO DESARROLLO LOCAL. Con "true", el frontend no envía a la sala de espera y
# trata al usuario como aprobado (muestra una franja de aviso). Solo funciona con
# el servidor de desarrollo de Vite; en producción y en previews de Vercel se
# ignora siempre. No desactiva el control del backend ni RLS. Déjala vacía.
VITE_DEV_SKIP_ACCESS_CHECK=

# --- Backend (solo Vercel Functions) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Live (SPEC-002). La API key solo en el backend.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Modelo de texto para el resumen (SPEC-002 §7)
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Vacía = voz por defecto de Gemini
GEMINI_VOICE=
MAX_SESSION_SECONDS=420
DAILY_SESSION_LIMIT=10

# Seguridad y operación (SPEC-006, SPEC-007)
# Dominios extra permitidos además del propio, separados por comas; admite *
# en el subdominio, p. ej. https://english-education-*.vercel.app
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_DAYS=90
# Secreto del cron de retención (Vercel lo envía como Bearer)
CRON_SECRET=

# Email a administradores (SPEC-004)
RESEND_API_KEY=
EMAIL_FROM=
ACCESS_WEBHOOK_SECRET=
APP_URL=
