# Plantilla de variables de entorno (SPEC-007). Copia a .env.local y rellena los valores.
# Nunca pongas valores reales en este archivo.

# --- Frontend (expuestas al navegador) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (solo Vercel Functions) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Live (SPEC-002). La API key solo en el backend.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Vacía = voz por defecto de Gemini
GEMINI_VOICE=
MAX_SESSION_SECONDS=420
DAILY_SESSION_LIMIT=10

# Email a administradores (SPEC-004)
RESEND_API_KEY=
EMAIL_FROM=
ACCESS_WEBHOOK_SECRET=
APP_URL=
